{
  "expo": {
    "name": "Moodverse",
    "slug": "moodverse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF9F6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moodverse.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FAF9F6"
      },
      "package": "com.moodverse.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Moodverse — AI Mood Scanner & Mindful Wellness",
      "shortName": "Moodverse",
      "description": "Mindful mental wellness mobile application featuring AI mood detection, 25 anti-stress relaxing games, guided meditation breathwork, and yoga postures.",
      "themeColor": "#FAF9F6",
      "backgroundColor": "#FAF9F6",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
