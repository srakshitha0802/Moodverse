{
  "expo": {
    "name": "Moodverse",
    "slug": "moodverse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121420"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moodverse.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#121420"
      },
      "package": "com.moodverse.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
